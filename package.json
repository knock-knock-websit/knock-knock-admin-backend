{
  "name": "knock-knock-admin-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs/dev.log wrangler dev --config wrangler.jsonc --port 8788 --persist-to ../.wrangler/shared-state",
    "d1:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs/migrate.log wrangler d1 migrations apply knock-knock --local --persist-to ../.wrangler/shared-state --config wrangler.jsonc",
    "d1:execute:local": "wrangler d1 execute knock-knock --local --persist-to ../.wrangler/shared-state --config wrangler.jsonc",
    "password:hash": "node scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs/build.log wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "5.9.3",
    "wrangler": "4.123.0"
  }
}
